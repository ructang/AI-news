{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh", "en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-business"
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 120,
      "profile": "ai-news"
    },
    "rss": [
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "ai-business",
        "profile": "ai-business"
      },
      {
        "name": "VentureBeat AI",
        "url": "https://venturebeat.com/category/ai/feed/",
        "enabled": true,
        "category": "ai-business",
        "profile": "ai-business"
      },
      {
        "name": "The Verge AI",
        "url": "https://www.theverge.com/rss/ai-artificial-intelligence/index.xml",
        "enabled": true,
        "category": "ai-apps",
        "profile": "ai-business"
      },
      {
        "name": "Stratechery",
        "url": "https://stratechery.com/feed/",
        "enabled": true,
        "category": "ai-business-analysis",
        "profile": "ai-business"
      },
      {
        "name": "机器之心",
        "url": "https://www.jiqizhixin.com/rss",
        "enabled": true,
        "category": "ai-cn",
        "profile": "ai-news"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tech",
        "profile": "ai-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "ai-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "ai-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "google_news": {
      "enabled": true,
      "query": "artificial intelligence company OR startup OR funding OR revenue",
      "language": "en",
      "country": "US",
      "max_results": 40,
      "category": "ai-business",
      "profile": "ai-business"
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "watchlists": [
        {
          "name": "ai-companies",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "ai-companies-finance",
          "symbols": ["NVDA", "MSFT", "GOOGL", "META", "AMZN", "TSLA", "AMD", "PLTR"],
          "profile": "ai-business"
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "request_body": {},
    "headers": ""
  }
}
